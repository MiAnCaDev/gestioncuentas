# Administrador inicial (solo se usa la primera vez, cuando la BD está vacía).
# La contraseña: 8+ caracteres con mayúscula, minúscula y número.
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esta-contraseña
# Opcional: tu ID de Telegram para que el admin ya pueda usar el bot
ADMIN_TELEGRAM_ID=

# Token del bot (se obtiene con @BotFather). Si se deja vacío, el bot no arranca.
TELEGRAM_BOT_TOKEN=

# Horario de los informes de Telegram (formato cron: minuto hora día-del-mes mes día-de-la-semana).
# Si se omiten: diario a las 9:00 y mensual el día 1 a las 9:00.
DAILY_REPORT_CRON=0 9 * * *
MONTHLY_REPORT_CRON=0 9 1 * *

# Zona horaria (afecta a las fechas por defecto y a los informes programados)
TZ=Europe/Madrid

# true porque se accede por HTTPS a través del túnel de Cloudflare
COOKIE_SECURE=true

# Enlaces que se muestran en el bot (/web) y en la web
WEB_URL=https://gestioncuentas.mianca.com.es
BOT_URL=https://t.me/gestioncuentas_bot
